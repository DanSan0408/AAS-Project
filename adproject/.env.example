# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=replace-me-with-secure-password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/aas_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root

# Super Admin Bootstrap (Initial setup only)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Application Security Keys
APP_SECURITY_REMEMBER_ME_KEY=
APP_SECURITY_BEHIND_PROXY=false

# Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=

# CI/CD & Deployment (GitHub "production" environment secrets; see CICD.md). There is no staging.
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_APP_ID=
DOKPLOY_AI_ID=
IAMS_APP_HEALTH_URL=
# Optional: the AI service is normally only reachable inside Docker
IAMS_AI_HEALTH_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEPLOY_CHAT_ID=
# Runtime alerts from the app itself (falls back to TELEGRAM_DEPLOY_CHAT_ID when empty)
TELEGRAM_ALERT_CHAT_ID=

# Public Application URL (Used for reset links & notifications)
APP_PUBLIC_BASE_URL=http://localhost:8080
# Production: https://iams.eduinnovax.com

# System Alerts
ADPROJECT_ALERTS_ENABLED=true
ADPROJECT_ALERTS_RECIPIENT_EMAIL=
ADPROJECT_ALERTS_THRESHOLD_CRITICAL_ERRORS=10

# Docker Compose only: persistent report uploads on the host (Linux VPS default).
# For a separate Dokploy application, configure Advanced > Volumes/Mounts instead.
# Create this directory and initialise appuser ownership before starting the app.
# See DEPLOYMENT_STORAGE.md. For local Docker development, use ./uploads instead.
APP_UPLOAD_HOST_DIR=/srv/iams/uploads

# AI Microservice & Google Gemini Configuration
# Add your Gemini API Key here for local dev; in Dokploy configure in the Environment tab
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SERVICE_URL=http://ai-service:8000
# Shared secret between the app and the AI service. Generate one: openssl rand -hex 24
# The AI service refuses to start with an empty, short or placeholder value (set DEBUG=true on it for local development only).
AI_INTERNAL_SECRET=
# The app reads new pending comments with the AI every 15 minutes (advice only; nothing is approved or rejected). Set false to turn it off.
COMMENT_SCAN_ENABLED=true
