# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=replace-me-with-secure-password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/aas_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root

# Super Admin Bootstrap (Initial setup only)
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Application Security Keys
APP_SECURITY_REMEMBER_ME_KEY=
APP_SECURITY_BEHIND_PROXY=false

# Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=

# Public Application URL (Used for reset links & notifications)
APP_PUBLIC_BASE_URL=http://localhost:8080

# System Alerts
ADPROJECT_ALERTS_ENABLED=true
ADPROJECT_ALERTS_RECIPIENT_EMAIL=
ADPROJECT_ALERTS_THRESHOLD_CRITICAL_ERRORS=10

# Docker Compose only: persistent report uploads on the host (Linux VPS default).
# For a separate Dokploy application, configure Advanced > Volumes/Mounts instead.
# Create this directory and initialise appuser ownership before starting the app.
# See DEPLOYMENT_STORAGE.md. For local Docker development, use ./uploads instead.
APP_UPLOAD_HOST_DIR=/srv/iams/uploads
